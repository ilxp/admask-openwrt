# --- 基本设置 (Basic Settings) ---
msgid "AdMask core runtime parameters. Requires service restart to take effect."
msgstr "AdMask 核心运行参数。修改后需重启服务生效。"

msgid "General Parameters"
msgstr "常规参数"

msgid "Transparent proxy must listen on 0.0.0.0 — do not change to 127.0.0.1. Firewall rules will sync automatically when changing ports."
msgstr "透明代理必须监听 0.0.0.0——不要改成 127.0.0.1。改端口时防火墙规则会自动同步。"

msgid "Rule Source Auto-Update Interval"
msgstr "规则源自动更新间隔"

msgid "6 Hours"
msgstr "6 小时"

msgid "12 Hours"
msgstr "12 小时"

msgid "24 Hours"
msgstr "24 小时"

msgid "7 Days"
msgstr "7 天"

msgid "Generic CSS Injection Limit"
msgstr "Generic CSS 注入上限"

msgid "Controls the injection of generic CSS (element hiding rules not bound to a specific host).<br><b>1500</b> (Default, Strongly Recommended): Covers the current 1.2MB measured size while preventing extreme bloat.<br><b>0</b> = Unlimited: Full injection (for desktop / x86).<br><b>Positive number</b> = Manual value (KB).<br>⚠️ Warning: Do NOT set to 500~800! ABP generic rules are \"all or nothing\"; setting it too low will cause page element hiding to completely fail.<br>Requires restart to take effect."
msgstr "控制 generic CSS（不绑定 host 的元素隐藏规则）的注入。<br><b>1500</b>（默认，强推）：覆盖当前 1.2MB 实测大小，同时防极端膨胀。<br><b>0</b> = 不限：全量注入（桌面 / x86 可用）。<br><b>正数</b> = 手动值（KB）。<br>⚠️ 警告：请勿设置为 500~800！ABP 的 generic 规则是「全有或全无」，设置过低会导致页面元素隐藏完全失效。<br>修改后需重启 AdMask 生效。"

msgid "Security Filter Engine"
msgstr "安全过滤引擎"

msgid "Auto-detect (Default, Recommended)"
msgstr "自动查找（默认，推荐）"

msgid "Force built-in Go engine (Disable sub-engine)"
msgstr "强制内嵌 Go 引擎（禁用副引擎）"

msgid "<b>auto</b> (Default): Automatically searches for the <code>adblock-engine</code> binary in the same directory as the main program on startup. Uses Rust core if found, otherwise degrades to built-in Go engine.<br>⚠️ Requires restart to take effect."
msgstr "<b>auto</b>（默认）：启动时自动在主程序同目录下查找 <code>adblock-engine</code> 二进制。找到就使用 Rust 核心，找不到则自动降级到内嵌 Go 引擎。<br>⚠️ 修改后需重启 AdMask 生效。"

msgid "Upstream Proxy"
msgstr "上游代理"

msgid "Enter the local HTTP proxy address if you use PassWall. LAN IPs are auto-excluded to prevent loops.<br>Example: <code>http://127.0.0.1:7890</code> (Leave blank for direct)."
msgstr "如果您使用 PassWall 等代理，请填写其本地 HTTP 代理地址。内网 IP 已自动排除以防死循环。<br>示例：<code>http://127.0.0.1:7890</code>（留空则直连）。"

msgid "Offline Mode"
msgstr "离线模式"

msgid "Do not load online threat intelligence sources — use manual rules only"
msgstr "不加载在线威胁情报源——只用手动规则"

msgid "Certificate Cache Size"
msgstr "证书缓存数量"

msgid "Verbose Debug Logs"
msgstr "详细调试日志"

msgid "When enabled (-v), AdMask records massive underlying debug information (e.g., every connection, every allow). ⚠️ This drastically consumes CPU and rapidly bloats the log file. Please keep it OFF for daily use. (Regardless of whether it is enabled, key blocking logs are recorded in /var/log/admask-18080.log and can be viewed on the \"Logs\" page above.) Only enable temporarily when troubleshooting \"Why is a website not opening\" or \"Why is an ad not blocked\"."
msgstr "开启后（-v），AdMask 会记录海量的底层调试信息（如每一次连接、每一次放行）。⚠️ 这会急剧消耗 CPU 并让日志文件迅速膨胀。日常请务必保持关闭。（无论是否开启，拦截威胁的关键战报都会记录在 /var/log/admask-18080.log 中，并可在上方“日志”页面查看。）仅在排查“为什么某个网站打不开”或“为什么某个广告没拦截”时临时开启。"

msgid "Debug dump m3u8"
msgstr "调试 dump m3u8"

msgid "Save every m3u8 playlist to the dump directory (for debugging)."
msgstr "把每个 m3u8 播放列表存盘到 dump 目录（调试用）。"

msgid "Debug dump mixer JSON"
msgstr "调试 dump mixer JSON"

msgid "Save every mixer JSON response to the dump directory (for debugging)."
msgstr "把每个 mixer JSON 响应存盘到 dump 目录（调试用）。"

msgid "Dump Directory"
msgstr "dump 目录"

msgid "Shared save directory for m3u8 and mixer JSON.<br>⚠️ Only created when any of the dump switches above are turned on."
msgstr "m3u8 与 mixer JSON 共用的存盘目录。<br>⚠️ 只有上面任一 dump 开关打开时才会创建。"

msgid "Dump File Count Limit"
msgstr "dump 文件数上限"

msgid "Maximum number of files in the dump directory — triggers cleanup every 100 dumps if exceeded, deleting the oldest half.<br><b>0</b> = Unlimited (⚠️ Long-term operation may fill up disk)<br><b>Positive number</b> = Manual value: users with large disks can increase it (e.g., 50000)<br>Default is 10000 — occupies about 100 MB~1 GB of disk space (depending on file size)."
msgstr "dump 目录文件数上限——超过后每 100 次 dump 触发一次清理，删除最旧的一半。<br><b>0</b> = 不限（⚠️ 长期运行可能撑爆磁盘）<br><b>正数</b> = 手动值：大磁盘用户可调大（如 50000）<br>默认 10000——占用磁盘约 100 MB~1 GB（视文件大小而定）。"

msgid "Enable Element Picker"
msgstr "启用元素拾取器"

msgid "Press Ctrl+Shift+E on a page to pick and block any element. When enabled, an extra script is injected into every HTML page — websites may detect the presence of AdMask. Recommended to only enable temporarily when needed."
msgstr "页面按 Ctrl+Shift+E 拾取任意元素并屏蔽。开启后每个 HTML 页面会多注入一段脚本——网站可检测到 AdMask 的存在。建议只在需要拾取时临时开启。"

msgid "Streaming CDN Passthrough (Performance Optimization)"
msgstr "流媒体 CDN 直通（性能优化）"

msgid "Media CDN domains bypass security decryption — preserving HTTP/2/3 multiplexing, increasing video loading speed by 2-3 times, and significantly reducing router CPU/memory usage. Cost: trackers/ads on CDN domains are not filtered (actual impact is small — video ads mainly go through API/VAST layers). Disabling it intercepts everything: can filter ads on CDNs, but videos will noticeably slow down due to protocol degradation."
msgstr "媒体 CDN 域名不做安全解密——保留 HTTP/2/3 多路复用，视频加载速度提升 2-3 倍，路由器 CPU/内存占用显著下降。代价：CDN 域名上的追踪器/广告不过滤（实际影响很小——视频广告主要走 API/VAST 层）。关闭则全部接管：能过滤 CDN 上的广告，但视频会因协议降级明显变慢。"

# --- 证书管理 (Certificate Management) ---
msgid "Certificate Management"
msgstr "证书管理"

msgid "Root Certificate Status"
msgstr "根证书状态"

msgid "Root Certificate (Public Key)"
msgstr "根证书 (公钥)"

msgid "Root Certificate Private Key"
msgstr "根证书 (私钥)"

msgid "Generated"
msgstr "已生成"

msgid "bytes"
msgstr "字节"

msgid "Not Generated"
msgstr "未生成"

msgid "Status"
msgstr "状态"

msgid "Running Normally"
msgstr "运行正常"

msgid "Certificate not fully generated — please restart AdMask in the \"Basic Settings\" page"
msgstr "证书未完全生成 — 请前往“基础设置”页面重启 AdMask"

msgid "Strongly Recommended: Once the certificate is generated, please immediately download a migration backup in Step 2. If you reinstall the system later, simply restore the backup so all client devices won't need to reinstall certificates!"
msgstr "💡 强烈建议：证书生成后，请立即在第 2 步下载迁移备份。以后重装系统或恢复出厂设置时，直接恢复备份即可，所有客户端无需重新安装证书！"

msgid "1. Download Client CA Certificate"
msgstr "1. 下载客户端 CA 证书"

msgid "Install the Root CA on client devices so AdMask can decrypt and analyze traffic."
msgstr "在客户端设备上安装根 CA 证书，以便 AdMask 解密和分析流量。"

msgid "Download Root CA (.crt)"
msgstr "下载根 CA 证书 (.crt)"

msgid "Direct URL:"
msgstr "直链地址："

msgid "Need the full certificate chain (Root + Intermediate) for older devices?"
msgstr "老旧设备需要完整的证书链（根证书 + 中间证书）？"

msgid "Download Bundle (.tar)"
msgstr "下载证书链包 (.tar)"

msgid "2. Migration & Backup"
msgstr "2. 迁移与备份"

msgid "Contains CA PRIVATE KEY — anyone with this file can decrypt ALL HTTPS traffic on your network!"
msgstr "⚠️ 包含 CA 私钥 — 任何持有此文件的人都可以解密您网络上的所有 HTTPS 流量！"

msgid "Only use when migrating AdMask to a new router or reinstalling firmware. NOT for client certificate installation. Generated on-demand — NEVER stored on the router."
msgstr "仅限在将 AdMask 迁移到新路由器或重装固件时使用。不可用于客户端证书安装。按需生成 — 绝不在路由器上留存。"

msgid "Download Migration Backup"
msgstr "🔐 下载迁移备份"

msgid "Restore from Backup"
msgstr "⬆️ 从备份恢复"

msgid "3. Regenerate Root CA (Dangerous)"
msgstr "3. 重新生成根 CA (危险操作)"

msgid "After regeneration, all devices will need to reinstall the new CA certificate, otherwise they will lose internet access!"
msgstr "重新生成后，所有设备都需要重新安装新的 CA 证书，否则将无法上网！"

msgid "Regenerate CA"
msgstr "🔄 重新生成 CA"

