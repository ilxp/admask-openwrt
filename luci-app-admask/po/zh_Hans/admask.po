msgid "Full backup contains your CA PRIVATE KEY. Anyone with this file can decrypt all HTTPS traffic on your network. Continue?"
msgstr "完整备份包含 CA 私钥。任何持有此文件的人都可以解密您网络上的所有 HTTPS 流量。是否继续？"

msgid "CA files missing"
msgstr "CA 文件缺失"

msgid "Migration backup downloaded. STORE SECURELY!"
msgstr "迁移备份下载已开始。请安全保管！"

msgid "Migration backup failed:"
msgstr "迁移备份失败："

msgid "Please select a backup file first"
msgstr "请先选择一个备份文件"

msgid "Restore will overwrite the current CA. Are you sure you want to continue?"
msgstr "恢复操作将覆盖当前的 CA，您确定要继续吗？"

msgid "Uploading and restoring, please wait..."
msgstr "正在上传并恢复，请稍候..."

msgid "Invalid backup file format. Only .tar files are supported."
msgstr "备份文件格式无效。仅支持 .tar 文件。"

msgid "Failed to read file"
msgstr "读取文件失败"

msgid "✅ Processing complete, AdMask is restarting..."
msgstr "✅ 处理完成，AdMask 正在重启..."

msgid "Restore failed:"
msgstr "恢复失败："

msgid "Are you sure you want to regenerate the CA?"
msgstr "您确定要重新生成 CA 吗？"

msgid "Type \"REGENERATE\" to confirm: "
msgstr "输入“REGENERATE”以确认："

msgid "CA regenerated, restarting..."
msgstr "CA 已重新生成，正在重启..."

# --- 订阅管理 (Subscriptions) ---
msgid "Configure ABP rule subscription sources. You can add anti-fraud, malicious blocking, or basic ad-blocking rules. Requires service restart to take effect."
msgstr "配置 ABP 规则订阅源。可以添加反诈、恶意拦截或基础去广告规则。修改后需重启服务生效。"

msgid "Name"
msgstr "名称"

msgid "Type"
msgstr "类型"

msgid "Online Subscription"
msgstr "在线订阅"

msgid "Local File"
msgstr "本地文件"

msgid "Subscription URL"
msgstr "订阅 URL"

msgid "Local Path"
msgstr "本地路径"

msgid "Update Interval"
msgstr "更新间隔"

msgid "Go duration format: 30m / 6h / 24h / 168h"
msgstr "时长格式（Go duration）：30m / 6h / 24h / 168h"

# --- 黑白名单 (Whitelist & Blacklist) ---
msgid "Whitelist & Blacklist Management"
msgstr "黑白名单管理"

msgid "Whitelist (Trusted Allow)"
msgstr "白名单（信任放行）"

msgid "Syntax: @@||domain^ — Allow this domain and all its subdomains. Used to avoid accidentally blocking legitimate services. Supports ! comments."
msgstr "语法：@@||domain^ —— 放行该域名及其所有子域。用于避免误拦截合法业务。支持 ! 注释。"

msgid "Blacklist (Force Block)"
msgstr "黑名单（强制拦截）"

msgid "Syntax: ||domain^ — Block this domain and all its subdomains. You can add scam, malicious, or unwanted websites here. Supports ! comments."
msgstr "语法：||domain^ —— 拦截该域名及其所有子域。可以填入诈骗、恶意或你不想访问的网站。支持 ! 注释。"

# --- 自定义规则 (Custom Rules) ---
msgid "Add custom blocking domains, CSS hiding rules, or custom defense scripts here."
msgstr "在此处添加自定义的拦截域名、CSS 隐藏规则或自定义防御脚本。"

# --- HLS 规则 ---
msgid "Used to identify and block malicious ad segments inserted in HLS streams."
msgstr "用于识别和阻断 HLS 流媒体中插入的恶意广告片段。"

# --- 视频服务规则 (Video Service Rules) ---
msgid "Deep filtering for video services, including API response interception and streaming ad blocking."
msgstr "针对视频服务进行深度过滤，包括 API 响应拦截和流媒体广告阻断。"

# --- CDN 直通 (CDN Passthrough) ---
msgid "Domains listed here will bypass security decryption and establish direct encrypted connections to improve media loading speed. Passthrough will abandon security protection for these domains."
msgstr "列在此处的域名将跳过安全解密，直接建立加密连接，以提升媒体加载速度。直通将放弃该域名的安全防护。"

# --- 访问控制 (Access Control) ---
msgid "Select which devices/networks use AdMask. All sources are randomly distributed among all instances by default — each connection is randomly assigned to an instance by nft for automatic load balancing."
msgstr "选择哪些设备/网段走 AdMask 代理。所有源默认随机分发到全部实例——每连接由 nft 独立随机选择实例，自动负载均衡。"

msgid "Global Settings"
msgstr "全局设置"

msgid "Enable Proxy"
msgstr "启用代理"

msgid "Master switch — when disabled, traffic from all devices bypasses AdMask."
msgstr "主开关——关闭后所有设备的流量不再经过 AdMask。"

msgid "LAN Subnet (IPv4)"
msgstr "LAN 网段（IPv4）"

msgid "LAN Subnet (IPv6)"
msgstr "LAN 网段（IPv6）"

msgid "Block QUIC Protocol"
msgstr "阻断 QUIC 协议"

msgid "Block UDP 443 — prevents malware or websites from bypassing the security gateway via QUIC"
msgstr "屏蔽 UDP 443——防止恶意软件或网站通过 QUIC 绕过安全网关"

msgid "Extra Instances"
msgstr "扩展实例"

msgid "Extra instances — additional AdMask processes besides 'main'. The 'main' instance listens on the configured address and cannot be deleted. All protected sources are distributed among all instances (including 'main') by default."
msgstr "扩展实例——除 main 之外的额外 AdMask 进程。main 实例固定监听配置的地址，不可删除。所有受保护源默认随机分发到全部实例（含 main）。"

msgid "Port"
msgstr "端口"

msgid "Must differ from the main port and not conflict with other extra instances."
msgstr "必须与 main 端口不同——且与其他扩展实例不冲突。"

msgid "Protected Sources"
msgstr "受保护源"

msgid "Protected Sources — matching traffic passes through AdMask. Supports MAC / IPv4 / IPv6 / CIDR (auto-detected). Protected devices must install the Root CA certificate."
msgstr "受保护源——匹配的流量经过 AdMask 代理。支持 MAC 地址 / IPv4 / IPv6 / CIDR（自动识别格式）。受保护设备需安装根 CA 证书。"

msgid "(Optional)"
msgstr "（选填）"

msgid "Source"
msgstr "源地址"

msgid "MAC / IPv4 / IPv6 / CIDR — auto-detected formats:<br><code>aa:bb:cc:dd:ee:ff</code> → MAC<br><code>192.168.1.50</code> → IPv4<br><code>192.168.3.0/24</code> → IPv4 CIDR<br><code>2001:db8::1</code> → IPv6<br><code>2001:db8::/64</code> → IPv6 CIDR"
